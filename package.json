{
  "name": "musica-mathematica",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "license": "UNLICENSED",
  "description": "Browser-local university music mathematics workbench with 24 inquiry-led lessons across eight domains.",
  "homepage": "https://sebastianspicker.github.io/musica-mathematica/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastianspicker/musica-mathematica.git"
  },
  "bugs": {
    "url": "https://github.com/sebastianspicker/musica-mathematica/issues"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:pages": "vite build --mode pages",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build"
  },
  "dependencies": {
    "fft.js": "^4.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "typescript": "^5.8.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
